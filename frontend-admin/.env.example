# URL da API Spring Boot. Em dev com `npm run dev`, pode omitir (usa proxy do Vite para localhost:8080).
# VITE_API_BASE_URL=http://localhost:8080
# Opcional: URL base dos ficheiros legados (capas). Tem de acabar em /legacy/assets ou sera anexado
# automaticamente (o backend so libera GET anonimos em /legacy/assets/**).
# Exemplo completo: http://localhost:8080/legacy/assets
# Se omitido, usa VITE_API_BASE_URL + /legacy/assets
# VITE_LEGACY_ASSETS_BASE_URL=http://localhost:8080/legacy/assets
